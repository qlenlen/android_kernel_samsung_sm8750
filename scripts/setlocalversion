#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
#
# Modified version that always outputs:
# <KERNELVERSION>-Qkernel-<git SHA prefix 10 chars>
#

usage() {
    echo "Usage: $0 [--no-local] [srctree]" >&2
    exit 1
}

no_local=false
if test "$1" = "--no-local"; then
    no_local=true
    shift
fi

srctree=.
if test $# -gt 0; then
    srctree=$1
    shift
fi
if test $# -gt 0 -o ! -d "$srctree"; then
    usage
fi

get_git_sha() {
    (
        cd "$srctree" >/dev/null 2>&1 || exit 1
        
        head=$(git rev-parse --verify HEAD 2>/dev/null)
				printf '%s%s' g "$(echo $head | cut -c1-10)"
    ) || echo "nogit"
}

if [ -z "${KERNELVERSION}" ]; then
    echo "KERNELVERSION is not set" >&2
    exit 1
fi

# Get git SHA (first 10 chars)
git_sha=$(get_git_sha)

if [ -n "${git_sha}" ]; then
    echo "${KERNELVERSION}-Qkernel-${git_sha}"
else
    echo "${KERNELVERSION}-Qkernel-nogit"
fi

exit 0